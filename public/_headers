/index.html
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/docs/*.pdf
  Cache-Control: no-store

/recorrido-afiches.css
  Cache-Control: public, max-age=31536000, immutable

/recorrido-afiches.js
  Cache-Control: public, max-age=31536000, immutable

/paginas.css
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/team/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/studies/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

